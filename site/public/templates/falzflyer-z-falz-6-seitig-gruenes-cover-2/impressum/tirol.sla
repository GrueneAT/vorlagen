    <PAGEOBJECT XPOS="147.8808503937008" YPOS="91.76283464566929" OwnPage="0" ItemID="100000014" PTYPE="4" WIDTH="218.883968503937" HEIGHT="55.00006299212599" CLIPEDIT="0" PWIDTH="0" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="11.338582677165356" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" gXpos="147.8808503937008" gYpos="91.76283464566929" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" ROT="0" FRTYPE="0" path="M0 0 L218.884 0 L218.884 55.0001 L0 55.0001 L0 0 Z" copath="M0 0 L218.884 0 L218.884 55.0001 L0 55.0001 L0 0 Z" ANNAME="u1b0_l2">
