---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map(t => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props;
const { Content } = await render(t);

// Nur eine "Anleitung" zeigen, wenn die Vorlage auch eine hat (USAGE.md →
// Body). Templates ohne USAGE.md rendern keine leere Überschrift.
const hasAnleitung = Boolean(t.body && t.body.trim().length > 0);

const BASE = import.meta.env.BASE_URL;
const url = (p: string) => BASE + p.replace(/^\//, '');

// Breadcrumb category step. Mirrors the grouping in index.astro /
// typ/[category].astro: templates without a category fall back to `other`,
// for which typ/[category].astro still generates a route.
const catId = t.data.category ?? 'other';
const catLabel = t.data.category_label ?? 'Sonstige';
---
<Base title={t.data.title}>
  <Breadcrumb items={[
    { label: 'Galerie', href: url('/') },
    { label: catLabel, href: url(`typ/${catId}/`) },
    { label: t.data.title },
  ]} />
  <h1 class="gat-headline">{t.data.title}</h1>
  <p>{t.data.description}</p>

  {/* Prominenter Schrift-Hinweis: die Vorlagen sind in Gotham Narrow +
      Vollkorn gesetzt; ohne installierte Schriften werden sie falsch
      dargestellt. Wortlaut ist mit dem Bundesbüro abgestimmt — bitte nicht
      umformulieren. Gotham Narrow ist proprietär und darf hier NICHT zum
      Download angeboten werden (deshalb der Verweis auf das Landesbüro);
      Vollkorn ist SIL-OFL und liegt als Download bei. Rendert auf jeder
      Template-Seite. */}
  <div class="gat-callout gat-callout--warn app-font-notice">
    <p style="margin: 0 0 0.5rem 0;">
      <strong>Wichtig – Schriften zuerst installieren:</strong> Damit die Vorlage
      korrekt dargestellt wird, müssen die benötigten Schriften vor dem Öffnen des
      Dokuments heruntergeladen und auf deinem Rechner installiert sein.
    </p>
    {/* Die Handlungsaufforderung steht bewusst als eigener Block: der Satz ist
        das, was Nutzer:innen tun müssen, und ginge im Fließtext unter. Kein
        <mark>, weil der Warn-Callout selbst schon blassgelb (#fdf3d2) ist —
        ein gelbes Highlight hätte darauf kaum Kontrast. */}
    <p class="app-font-notice__action">
      <strong>Bitte wendet euch dafür an euer Landesbüro.</strong>
    </p>
    <p style="margin: 0 0 0.5rem 0;">
      Andernfalls kann es passieren, dass die Vorlage mit einer Ersatzschrift
      angezeigt wird. Das kann zu verschobenen Zeilenumbrüchen, falschen
      Abständen und anderen Darstellungsfehlern führen.
    </p>
    <p style="margin: 0;">
      <a href={url('/fonts/gruene-vorlagen-schriften.zip')} class="app-font-notice__dl">
        ↓ Vollkorn herunterladen (freie Akzentschrift, inkl. Installations-Anleitung)
      </a>
    </p>
  </div>

  {t.data._previews && t.data._previews.length > 0 && (
    <div class="app-preview-grid">
      {t.data._previews.map((p, i) => {
        // Issue #28: every preview thumbnail clicks through to a hi-res
        // version rendered at 150 dpi (vs 50–100 dpi for thumbnails).
        // Hi-res lives next to the thumbnail with `-hires` suffix
        // (page-01.png → page-01-hires.png) and is mirrored to
        // site/public/templates/<id>/ by the render pipeline.
        const hiresSrc = p.src.replace(/\.png$/, '-hires.png');
        return (
          <a
            href={url(hiresSrc)}
            class="app-lightbox-trigger app-preview-grid__item"
            data-lightbox-target="preview-lightbox"
            data-lightbox-group="default"
            data-lightbox-index={i}
            data-hires={url(hiresSrc)}
            data-label={p.label}
            aria-label={`Vergrößerte Vorschau öffnen: ${p.label}`}
          >
            <img src={url(p.src)} alt={p.label} loading="lazy" />
            <div class="app-preview-grid__caption">{p.label}</div>
          </a>
        );
      })}
    </div>
  )}

  {/* Shared lightbox component (Issue #126 Phase 2). Konsolidiert
      die drei lokal duplizierten Lightbox-Implementierungen
      (templates, experiments, schriften) auf <dialog class="gat-modal">. */}
  <Lightbox id="preview-lightbox" hasNav />

  <h2 class="gat-headline">Download</h2>
  <p>Bitte die Vorlage mit dem Impressum eures Bundeslandes herunterladen.</p>
  <ul>
    {t.data._downloads && t.data._downloads.map(d => (
      <li>
        {d.label}: <a href={url(d.sla)}>SLA herunterladen</a>
      </li>
    ))}
  </ul>
  {t.data._preview_pdf && (
    <p>Gemeinsame Vorschau: <a href={url(t.data._preview_pdf)}>Vorschau-PDF</a></p>
  )}

  {hasAnleitung && (
    <>
      <h2 class="gat-headline">Anleitung</h2>
      <Content />
    </>
  )}
</Base>
