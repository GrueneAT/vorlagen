---
/**
 * Anleitungsseite — ersetzt die GGS-NÖ-Seite "Scribus – Druckvorlagen &
 * Downloads". Texte und Videos sind von dort übernommen.
 *
 * Inhalte ändern, ohne diese Datei anzufassen:
 *   - Abschnitte/Prosa/Links → src/content/anleitung/*.md
 *   - Videos                 → src/data/videos.ts
 */
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import VideoModal from '../../components/VideoModal.astro';
import { videos } from '../../data/videos';
import { getCollection, render } from 'astro:content';

const BASE = import.meta.env.BASE_URL;
const url = (p: string) => BASE + p.replace(/^\//, '');

const sections = (await getCollection('anleitung')).sort(
  (a, b) => a.data.order - b.data.order
);

// Astro kann Content-Komponenten nicht innerhalb von .map() awaiten —
// deshalb vorab rendern und als Paare weiterreichen.
const rendered = await Promise.all(
  sections.map(async s => ({ data: s.data, Content: (await render(s)).Content }))
);

/** Interne Pfade brauchen das BASE-Präfix, externe bleiben unverändert. */
const hrefFor = (l: { href: string; kind: string }) =>
  l.kind === 'external' ? l.href : url(l.href);
---
<Base title="Anleitung">
  <Breadcrumb items={[{ label: 'Galerie', href: url('/') }, { label: 'Anleitung' }]} />

  <h1 class="gat-headline">Scribus – Anleitung &amp; Downloads</h1>

  <p>
    Scribus ist ein kostenloses, Open-Source-Desktop-Publishing-Programm, das
    speziell für die Erstellung von Layouts für Print- und Webpublikationen
    entwickelt wurde. Mit diesem Programm können Druckprodukte – wie Zeitungen
    oder Flyer – unter Berücksichtigung der für Druckereien erforderlichen
    Vorgaben gestaltet werden. Wir haben für euch Vorlagen für verschiedene
    Druckprodukte erstellt, die ihr nach dem Download des Programms bearbeiten
    könnt.
  </p>
  <p>
    Unten findet ihr eine Schritt-für-Schritt-Anleitung, die euch durch den
    Bearbeitungsprozess führt. Ein Klick auf ein Video öffnet es direkt hier
    auf der Seite.
  </p>

  <h2 class="gat-headline app-section-head">Video-Anleitungen</h2>
  <VideoGrid videos={videos} modalId="anleitung-video" />

  <h2 class="gat-headline app-section-head">Schritt für Schritt</h2>
  <div class="app-steps">
    {rendered.map(({ data, Content }) => (
      <section class={data.callout ? `gat-callout gat-callout--${data.callout} app-step` : 'app-step'}>
        <h3 class="gat-headline app-step__title">{data.title}</h3>
        <div class="app-step__body">
          <Content />
        </div>
        {data.links && data.links.length > 0 && (
          <ul class="app-step__links">
            {data.links.map(l => (
              <li>
                <a
                  href={hrefFor(l)}
                  class="app-step__link"
                  target={l.kind === 'external' ? '_blank' : undefined}
                  rel={l.kind === 'external' ? 'noopener noreferrer' : undefined}
                >
                  <span aria-hidden="true">{l.kind === 'download' ? '↓' : l.kind === 'external' ? '↗' : '→'}</span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>

  <VideoModal id="anleitung-video" />
</Base>
